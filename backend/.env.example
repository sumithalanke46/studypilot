# StudyPilot Backend Environment Configuration
PROJECT_NAME="StudyPilot"
VERSION="1.0.0"
ENVIRONMENT="development"

# Security (Replace with a strong random secret in production)
JWT_SECRET="studypilot-super-secret-production-key-change-me-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./studypilot.db"
# Render PostgreSQL example:
# DATABASE_URL="postgresql://studypilot_user:password@dpg-xxxx.render.com/studypilot"

# AI Tutor / LLM API (Optional - application works 100% offline with built-in tutor engine)
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
